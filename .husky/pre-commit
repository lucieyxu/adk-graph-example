#!/bin/bash

# Prevent checking on template branches if needed
current_branch=$(git branch --show-current)
if [[ "$current_branch" == "template" || "$current_branch" == template-repo-sync/* ]]; then
    exit 0
fi

echo "Running pre-commit checks..."

# 1. Check formatting
uv run ruff format --check .
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Ruff formatting check failed."
    echo "👉 Run 'uv run ruff format .' to format your code."
    echo ""
    exit 1
fi

# 2. Check lint rules
uv run ruff check .
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Ruff lint check failed."
    echo "👉 Fix linting issues before committing."
    echo ""
    exit 1
fi

# 3. Optional: Run tests to ensure no regressions
uv run python -m pytest tests/unit/test_agent.py
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Unit tests failed."
    echo "👉 Fix test failures before committing."
    echo ""
    exit 1
fi

echo "✅ All checks passed. Proceeding with commit..."
