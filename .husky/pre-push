# !/bin/bash

current_branch=$(git branch --show-current)
if [[ "$current_branch" != "template" && "$current_branch" != template-repo-sync/* ]]; then
    echo "Running linters before push..."

    # BEFORE lint git status
    git status --porcelain > ".husky/tmp/before.txt"

    # LINT
    mise run lint

    # AFTER git status
    git status --porcelain > ".husky/tmp/after.txt"

    # COMPARE to see if linting introduced changes
    diff_result=$(diff -q ".husky/tmp/before.txt" ".husky/tmp/after.txt" || true)

    # PREVENT push if lint made changes
    if [[ "$diff_result" == "Files .husky/tmp/before.txt and .husky/tmp/after.txt differ" ]]; then
        echo "- - -"
        echo "- - -"
        echo ""
        echo "Linting was successful, but introduced changes. Aborting push."
        echo ""
        echo "Files changed during linting:"
        changed_files=$(diff ".husky/tmp/before.txt" ".husky/tmp/after.txt" | grep "^>" || true)
        echo ""
        echo "$changed_files"
        echo ""
        echo "Commit the new changes from the linter before pushing."
        echo ""
        echo "- - -"
        echo "- - -"
        exit 1
    fi

    echo "Linting successful. Continuing with push." 
fi