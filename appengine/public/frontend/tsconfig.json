{
    "extends": "./../../../tsconfig.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@src/*": ["./src/*"],
            "@public/*": ["./public/*"],
            "@shared/*": ["./../../../shared/*"]
        },
        "plugins": [
            {
                "name": "next"
            },
            {
                "name": "typescript-plugin-css-modules"
            }
        ]
    },
    "include": [
        ".*/**/*",
        "**/*",
        ".storyboook/preview.tsx",
        "../../../shared/**/*",
        ".next/types/**/*.ts",
        "next-env.d.ts",
        "dist/types/**/*.ts",
        "../../../types.d.ts"
    ]
}
