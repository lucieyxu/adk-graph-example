{
    "extends": "./../tsconfig.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@shared/*": ["./*"]
        },
        "plugins": [
            {
                "name": "next"
            },
            {
                "name": "typescript-plugin-css-modules"
            }
        ]
    },
    "include": [
        "../types.d.ts",
        ".*/**/*",
        "**/*",
        "../../shared/**/*",
        ".next/types/**/*.ts",
        "next-env.d.ts",
        "dist/types/**/*.ts",
        "../appengine/default/frontend/src/hooks/useRank.ts"
    ],
    "exclude": ["**/node_modules"]
}
